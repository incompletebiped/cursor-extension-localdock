{
  "name": "localdock-cpanel",
  "displayName": "LocalDock for cPanel",
  "description": "Pull, edit, and push WordPress sites hosted on cPanel/WHM — like LocalWP but for live servers.",
  "version": "0.1.13",
  "publisher": "incompletebiped",
  "repository": {
    "type": "git",
    "url": "https://github.com/incompletebiped/cursor-extension-localdock.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "wordpress",
    "cpanel",
    "sftp",
    "ssh",
    "whm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "localdockCpanel.addServer",
        "title": "Add cPanel Server",
        "icon": "$(add)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.testConnection",
        "title": "Test Connection",
        "icon": "$(plug)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.editServer",
        "title": "Edit Server",
        "icon": "$(edit)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.removeServer",
        "title": "Remove Server",
        "icon": "$(trash)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.refreshSites",
        "title": "Refresh Sites",
        "icon": "$(refresh)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.pullSite",
        "title": "Pull Site (Download)",
        "icon": "$(cloud-download)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.pushSite",
        "title": "Push Site (Upload)",
        "icon": "$(cloud-upload)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.diffSite",
        "title": "Show Changed Files",
        "icon": "$(diff)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.checkRemoteDiff",
        "title": "Check Remote for Changes",
        "icon": "$(cloud)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.provisionCompanionPlugin",
        "title": "Provision Companion Plugin",
        "icon": "$(package)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.checkCompanionDrift",
        "title": "Check for Changes (Companion Plugin)",
        "icon": "$(pulse)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.openSiteFolder",
        "title": "Open Site Folder",
        "icon": "$(folder-opened)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.cancelOperation",
        "title": "Cancel Operation",
        "icon": "$(stop-circle)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.startLocal",
        "title": "Start Local WordPress",
        "icon": "$(play)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.stopLocal",
        "title": "Stop Local WordPress",
        "icon": "$(debug-stop)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.openLocalSite",
        "title": "Open in Browser",
        "icon": "$(browser)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.resetLocalConfig",
        "title": "Reset Local Config",
        "icon": "$(refresh)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.openMailpit",
        "title": "Open Mail Inbox (Mailpit)",
        "icon": "$(mail)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.openAdminer",
        "title": "Open Database Browser (Adminer)",
        "icon": "$(database)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.openDockerSetup",
        "title": "Install Docker Desktop",
        "icon": "$(link-external)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.setSitesDirectory",
        "title": "Set Local Sites Folder",
        "icon": "$(folder)",
        "category": "LocalDock cPanel"
      },
      {
        "command": "localdockCpanel.checkForUpdates",
        "title": "Check for Updates (Dev)",
        "icon": "$(sync)",
        "category": "LocalDock cPanel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localdock-cpanel",
          "title": "LocalDock cPanel",
          "icon": "resources/icons/logo.svg"
        }
      ]
    },
    "views": {
      "localdock-cpanel": [
        {
          "id": "localdockCpanel.serverTree",
          "name": "Servers",
          "initialSize": 1,
          "visibility": "collapsed"
        },
        {
          "id": "localdockCpanel.siteTree",
          "name": "WordPress Sites",
          "initialSize": 6
        },
        {
          "id": "localdockCpanel.activityTree",
          "name": "Activity",
          "initialSize": 1
        },
        {
          "id": "localdockCpanel.localDockerTree",
          "name": "Local Environments",
          "initialSize": 2
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "localdockCpanel.addServer",
          "when": "view == localdockCpanel.serverTree",
          "group": "navigation"
        },
        {
          "command": "localdockCpanel.refreshSites",
          "when": "view == localdockCpanel.siteTree",
          "group": "navigation"
        },
        {
          "command": "localdockCpanel.setSitesDirectory",
          "when": "view == localdockCpanel.localDockerTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "localdockCpanel.testConnection",
          "when": "view == localdockCpanel.serverTree && viewItem == cpanelServer",
          "group": "inline"
        },
        {
          "command": "localdockCpanel.testConnection",
          "when": "view == localdockCpanel.serverTree && viewItem == cpanelServer",
          "group": "manage@1"
        },
        {
          "command": "localdockCpanel.editServer",
          "when": "view == localdockCpanel.serverTree && viewItem == cpanelServer",
          "group": "manage@2"
        },
        {
          "command": "localdockCpanel.removeServer",
          "when": "view == localdockCpanel.serverTree && viewItem == cpanelServer",
          "group": "manage@2"
        },
        {
          "command": "localdockCpanel.pullSite",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /wordpressSite/",
          "group": "sync@1"
        },
        {
          "command": "localdockCpanel.pullSite",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /pullState_needed/",
          "group": "inline"
        },
        {
          "command": "localdockCpanel.pushSite",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /wordpressSite/",
          "group": "sync@2"
        },
        {
          "command": "localdockCpanel.pushSite",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /pullState_ready/",
          "group": "inline"
        },
        {
          "command": "localdockCpanel.diffSite",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /wordpressSite/",
          "group": "sync@3"
        },
        {
          "command": "localdockCpanel.checkRemoteDiff",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /wordpressSite/",
          "group": "sync@4"
        },
        {
          "command": "localdockCpanel.provisionCompanionPlugin",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /wordpressSite/",
          "group": "companion@1"
        },
        {
          "command": "localdockCpanel.provisionCompanionPlugin",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /companion_(not_installed|inactive|unknown)/",
          "group": "inline"
        },
        {
          "command": "localdockCpanel.checkCompanionDrift",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /wordpressSite/",
          "group": "companion@2"
        },
        {
          "command": "localdockCpanel.openSiteFolder",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /wordpressSite/",
          "group": "open@1"
        },
        {
          "command": "localdockCpanel.startLocal",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /pullState_ready/ && viewItem =~ /localEnv_(stopped|error)/",
          "group": "local@1"
        },
        {
          "command": "localdockCpanel.startLocal",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /pullState_ready/ && viewItem =~ /localEnv_(stopped|error)/",
          "group": "inline"
        },
        {
          "command": "localdockCpanel.stopLocal",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /localEnv_running/",
          "group": "local@1"
        },
        {
          "command": "localdockCpanel.stopLocal",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /localEnv_running/",
          "group": "inline"
        },
        {
          "command": "localdockCpanel.openLocalSite",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /localEnv_running/",
          "group": "local@2"
        },
        {
          "command": "localdockCpanel.openMailpit",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /localEnv_running/",
          "group": "local@3"
        },
        {
          "command": "localdockCpanel.openAdminer",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /localEnv_running/",
          "group": "local@4"
        },
        {
          "command": "localdockCpanel.resetLocalConfig",
          "when": "view == localdockCpanel.siteTree && viewItem =~ /wordpressSite/",
          "group": "local@9"
        },
        {
          "command": "localdockCpanel.startLocal",
          "when": "view == localdockCpanel.localDockerTree && viewItem =~ /localEnv_(stopped|error)/",
          "group": "local@1"
        },
        {
          "command": "localdockCpanel.startLocal",
          "when": "view == localdockCpanel.localDockerTree && viewItem =~ /localEnv_(stopped|error)/",
          "group": "inline"
        },
        {
          "command": "localdockCpanel.stopLocal",
          "when": "view == localdockCpanel.localDockerTree && viewItem =~ /localEnv_running/",
          "group": "local@1"
        },
        {
          "command": "localdockCpanel.stopLocal",
          "when": "view == localdockCpanel.localDockerTree && viewItem =~ /localEnv_running/",
          "group": "inline"
        },
        {
          "command": "localdockCpanel.openLocalSite",
          "when": "view == localdockCpanel.localDockerTree && viewItem =~ /localEnv_running/",
          "group": "local@2"
        },
        {
          "command": "localdockCpanel.openMailpit",
          "when": "view == localdockCpanel.localDockerTree && viewItem =~ /localEnv_running/",
          "group": "local@3"
        },
        {
          "command": "localdockCpanel.openAdminer",
          "when": "view == localdockCpanel.localDockerTree && viewItem =~ /localEnv_running/",
          "group": "local@4"
        },
        {
          "command": "localdockCpanel.resetLocalConfig",
          "when": "view == localdockCpanel.localDockerTree && viewItem == localEnvItem",
          "group": "local@9"
        },
        {
          "command": "localdockCpanel.cancelOperation",
          "when": "view == localdockCpanel.activityTree && viewItem == runningOperation",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "LocalDock for cPanel",
      "properties": {
        "localdockCpanel.localSitesDirectory": {
          "type": "string",
          "default": "",
          "description": "Root directory where pulled sites are stored locally. Defaults to ~/localdock-sites."
        },
        "localdockCpanel.localMysqlHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Local MySQL host for database imports."
        },
        "localdockCpanel.localMysqlPort": {
          "type": "number",
          "default": 3306,
          "description": "Local MySQL port."
        },
        "localdockCpanel.localMysqlUser": {
          "type": "string",
          "default": "root",
          "description": "Local MySQL username."
        },
        "localdockCpanel.rejectUnauthorizedSsl": {
          "type": "boolean",
          "default": true,
          "description": "Verify SSL certificates on cPanel API calls (recommended). Disable only for servers with self-signed or locally-trusted certificates."
        },
        "localdockCpanel.sshPort": {
          "type": "number",
          "default": 22,
          "description": "Default SSH port for cPanel servers."
        },
        "localdockCpanel.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "wp-content/uploads/**",
            "wp-content/cache/**",
            "wp-content/backup-db/**",
            "*.log",
            ".DS_Store",
            "node_modules/**"
          ],
          "description": "Glob patterns to exclude during file sync."
        },
        "localdockCpanel.databaseSyncMethod": {
          "type": "string",
          "enum": [
            "mysqldump",
            "wpcli"
          ],
          "default": "mysqldump",
          "description": "Method to use for database export/import."
        },
        "localdockCpanel.fullDatabasePush": {
          "type": "boolean",
          "default": false,
          "description": "Force a full database dump-and-replace on every push instead of the changelog-driven incremental push (which sends only the options/posts/users the local Companion plugin recorded as changed). Enable for troubleshooting, or to deliberately promote the entire local database state to production."
        },
        "localdockCpanel.maxConcurrentTransfers": {
          "type": "number",
          "default": 20,
          "description": "Maximum concurrent SFTP file transfers. Requests are pipelined over one SSH connection, not one connection per file — safe to raise well above the old default of 5 for sites with many small files. Lower it if a host rate-limits SFTP activity."
        },
        "localdockCpanel.dockerStartPort": {
          "type": "number",
          "default": 8080,
          "description": "Starting port number for local Docker WordPress environments. Each site gets a unique port assigned sequentially."
        },
        "localdockCpanel.pullUploads": {
          "type": "boolean",
          "default": false,
          "description": "Include wp-content/uploads when pulling a site. Disabled by default because the media library can be very large. When disabled, missing uploads are proxied from the live server at runtime."
        },
        "localdockCpanel.uploadsSyncPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "uag-plugin/**",
            "hummingbird-assets/**"
          ],
          "description": "Upload subdirectory globs that are always pulled even when pullUploads is false. Paths are relative to wp-content/uploads/. Used for plugin-generated CSS/JS (Spectra/UAG, Hummingbird, etc.) so local environments load the correct styles."
        },
        "localdockCpanel.devRepoPath": {
          "type": "string",
          "default": "",
          "description": "Developer use only: path to this extension's local git repo. When set, LocalDock compares the repo's package.json version against the installed version and can rebuild, reinstall, and reload itself when the repo is ahead."
        },
        "localdockCpanel.autoCheckForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "When devRepoPath is set, automatically check the repo for a newer version on startup."
        },
        "localdockCpanel.trustedRemovableDrives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Drive letters (e.g. \"D\") that are removable but should still be treated as eligible for Docker bind-mounts — for an NTFS SD card or USB drive that's effectively permanently attached. Only applies to drives formatted NTFS/ReFS; exFAT/FAT and network drives are never eligible. Populated automatically when you choose \"Trust This Drive\" after a drive-eligibility warning."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "generate:companion": "node scripts/generate-companion-plugin-source.js",
    "build": "node esbuild.js",
    "build:prod": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "ssh2": "^1.16.0",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
