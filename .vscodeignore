# Source & build tooling — the shipped code is the bundled dist/extension.js
src/**
**/*.ts
**/*.map
esbuild.js
tsconfig.json
scripts/**

# Repo / editor / agent config
.vscode/**
.github/**
.claude/**
.gitignore
.vscodeignore
ROADMAP.md

# WordPress companion plugin — separate artifact, installed on the live site,
# never bundled into this extension's .vsix
wordpress-plugin/**

# Internal design/planning docs — not shipped in the package
docs/**

# Lockfiles & local artifacts (vsce already prunes devDependencies from node_modules)
package-lock.json
*.vsix
.env
*.log
**/.DS_Store
